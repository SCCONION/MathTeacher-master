# ── LLM ─────────────────────────────────────────────────────
# DeepSeek API Key（必填，用于推理）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ── Embedding ──────────────────────────────────────────────
# Cohere API Key（可选，Embedding 备用方案）
COHERE_API_KEY=your_cohere_api_key_here

# ── Search ─────────────────────────────────────────────────
# Tavily API Key（可选，联网搜索工具用）
TAVILY_API_KEY=your_tavily_api_key_here

# ── Memory ─────────────────────────────────────────────────
# Redis 连接串（本地默认；Codespaces 里会被 devcontainer 自动覆盖为 redis 服务名）
REDIS_URL=redis://:jee_secret@localhost:6379

# ── Google Login ───────────────────────────────────────────
# Google OAuth 2.0 Client ID（Web application 类型）
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
# Google OAuth Client Secret（前端 ID token 校验流程用不到，可留空）
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
OAUTH_REDIRECT_URI=http://localhost:8501/oauth2callback
